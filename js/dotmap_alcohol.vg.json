{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The drinking map",
    "subtitle": "Dot-density map — 1 dot ≈ 10,000 adults who exceed the alcohol guideline, 2022"
  },
  "width": 340,
  "height": 520,
  "projection": {
    "type": "conicEqualArea"
  },
  "layer": [
    {
      "data": {
        "url": "js/ausStates.topojson",
        "format": { "type": "topojson", "feature": "ausStates" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f3f0f7",
        "stroke": "white",
        "strokeWidth": 1.2
      }
    },
    {
      "data": { "url": "data/alcohol_dots.csv" },
      "mark": {
        "type": "circle",
        "color": "#6a3d9a",
        "opacity": 0.6,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude":  { "field": "lat", "type": "quantitative" },
        "size": { "value": 30 },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State / territory" }
        ]
      }
    },
    {
      "data": { "values": [{ "dummy": 1 }] },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 30,
            "color": "#6a3d9a",
            "opacity": 0.6,
            "stroke": "white",
            "strokeWidth": 0.3
          },
          "encoding": {
            "longitude": { "datum": 153 },
            "latitude":  { "datum": -41 }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "fontSize": 11,
            "fontStyle": "italic",
            "color": "#4a4a4a"
          },
          "encoding": {
            "longitude": { "datum": 153 },
            "latitude":  { "datum": -41 },
            "text": { "value": "1 dot ≈ 10,000 adults" }
          }
        }
      ]
    }
  ]
}