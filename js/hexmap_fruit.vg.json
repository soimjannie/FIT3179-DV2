{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Fruit falls short almost everywhere",
    "subtitle": "Adults not eating enough fruit (%), 2022 \u2014 one tile per state/territory"
  },
  "width": 360,
  "height": 420,
  "projection": {
    "type": "identity"
  },
  "layer": [
    {
      "data": {
        "url": "js/au_hex.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/state_risk_factors_2022.csv"
            },
            "key": "state",
            "fields": [
              "inadequate_fruit",
              "code"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "inadequate_fruit",
          "type": "quantitative",
          "title": "% not eating enough fruit",
          "scale": {
            "scheme": "oranges",
            "domain": [
              53,
              60
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 200,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "inadequate_fruit",
            "type": "quantitative",
            "title": "Inadequate fruit %"
          }
        ]
      }
    },
    {
      "data": {
        "url": "js/au_hex.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_CODE",
          "as": "lbl"
        },
        {
          "calculate": "datum.properties.cx",
          "as": "cx"
        },
        {
          "calculate": "datum.properties.cy",
          "as": "cy"
        }
      ],
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 12,
        "fill": "#3e2f1c"
      },
      "encoding": {
        "longitude": {
          "field": "cx"
        },
        "latitude": {
          "field": "cy"
        },
        "text": {
          "field": "lbl"
        }
      }
    }
  ]
}