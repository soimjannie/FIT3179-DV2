{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Smoking is not shared evenly",
    "subtitle": "Daily smoking rate (%) of adults, 2022 \u2014 circle area = rate"
  },
  "width": 660,
  "height": 540,
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "js/ausStates.topojson",
        "format": {
          "type": "topojson",
          "feature": "ausStates"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef1f4",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/state_risk_factors_2022.csv"
            },
            "key": "code",
            "fields": [
              "daily_smoking",
              "state"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#e75190",
        "opacity": 0.8,
        "stroke": "#a31c62",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "daily_smoking",
          "type": "quantitative",
          "title": "Daily smoking rate (%)",
          "scale": {
            "range": [
              60,
              1300
            ],
            "domain": [
              5,
              15
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 5,
            "title": "Daily smoking rate (%)",
            "titleAnchor": "start",
            "symbolFillColor": "#e75190",
            "symbolStrokeColor": "#a31c62",
            "symbolStrokeWidth": 1,
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "daily_smoking",
            "type": "quantitative",
            "title": "Daily smoking %"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_labels.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "dy": -22
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code",
          "type": "nominal"
        }
      }
    }
  ]
}