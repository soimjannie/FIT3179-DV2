{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where weight weighs heaviest",
    "subtitle": "Adults who are overweight or obese (%), 2022"
  },
  "width": 440,
  "height": 400,
  "projection": {
    "type": "conicEqualArea"
  },
  "data": {
    "url": "js/ausStates.topojson",
    "format": {
      "type": "topojson",
      "feature": "ausStates"
    }
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/state_risk_factors_2022.csv"
        },
        "key": "state",
        "fields": [
          "overweight_obese",
          "daily_smoking",
          "exceeded_alcohol",
          "code"
        ]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },
  "encoding": {
    "color": {
      "field": "overweight_obese",
      "type": "quantitative",
      "title": "% overweight / obese",
      "scale": {
        "scheme": "yelloworangered",
        "domain": [
          62,
          71
        ]
      },
      "legend": {
        "orient": "bottom",
        "gradientLength": 200,
        "format": ".0f"
      }
    },
    "tooltip": [
      {
        "field": "properties.STATE_NAME",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "overweight_obese",
        "type": "quantitative",
        "title": "Overweight/obese %"
      }
    ]
  }
}