{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Australia scores on each lifestyle factor",
    "subtitle": "% of all adults with the risk factor, 2022"
  },
  "width": 540,
  "height": 470,
  "data": {
    "url": "data/national_scorecard_2022.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#1f2d3d",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.2,
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "datum": 50
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 24,
        "cornerRadius": 12,
        "opacity": 1,
        "color": "#e76f51"
      },
      "encoding": {
        "y": {
          "field": "factor",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {
            "labelLimit": 240,
            "labelFontWeight": "bold",
            "labelFontSize": 12,
            "labelPadding": 12
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": "% of adults",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "titlePadding": 12,
            "tickCount": 6
          }
        },
        "tooltip": [
          {
            "field": "factor",
            "title": "Risk factor"
          },
          {
            "field": "value",
            "title": "% of adults",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": "bold",
        "fontSize": 12,
        "color": "#1f2d3d"
      },
      "encoding": {
        "y": {
          "field": "factor",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ]
}