{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Australia scores on each lifestyle factor",
    "subtitle": "% of all adults with the risk factor, 2022 · shaded bands mark risk severity"
  },
  "width": 380,
  "height": 450,
  "data": {
    "url": "data/national_scorecard_2022.csv"
  },
  "layer": [
    {
      "data": {
        "values": [
          { "x0": 0,  "x1": 25,  "zone": "Low" },
          { "x0": 25, "x1": 50,  "zone": "Moderate" },
          { "x0": 50, "x1": 75,  "zone": "High" },
          { "x0": 75, "x1": 100, "zone": "Very high" }
        ]
      },
      "mark": { "type": "rect", "opacity": 0.35 },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": { "domain": [0, 100] },
          "title": null,
          "axis": null
        },
        "x2": { "field": "x1" },
        "color": {
          "field": "zone",
          "type": "nominal",
          "scale": {
            "domain": ["Low", "Moderate", "High", "Very high"],
            "range": ["#e6f4f1", "#fdf6dd", "#fbe2d2", "#f6cfc4"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "stroke": "#1f2d3d",
        "strokeDash": [4, 3],
        "strokeWidth": 1.2,
        "opacity": 0.55
      },
      "encoding": {
        "x": { "datum": 50 }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 24,
        "cornerRadius": 12,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "factor",
          "type": "nominal",
          "title": null,
          "sort": "-x",
          "axis": {
            "labelLimit": 240,
            "labelFontWeight": "bold",
            "labelFontSize": 12,
            "labelPadding": 12
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": "% of adults",
          "scale": { "domain": [0, 100] },
          "axis": { "titlePadding": 12, "tickCount": 6 }
        },
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": { "scheme": "yelloworangered" },
          "legend": null
        },
        "tooltip": [
          { "field": "factor", "title": "Risk factor" },
          { "field": "value", "title": "% of adults", "format": ".1f" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontWeight": "bold",
        "fontSize": 12,
        "color": "#1f2d3d"
      },
      "encoding": {
        "y": {
          "field": "factor",
          "type": "nominal",
          "sort": "-x"
        },
        "x": { "field": "value", "type": "quantitative" },
        "text": { "field": "value", "type": "quantitative", "format": ".1f" }
      }
    }
  ]
}