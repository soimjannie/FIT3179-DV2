{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Australians are most active",
    "subtitle": "Circle size = adults who did any activity; colour = % active 3+ times a week (AusPlay 2025)"
  },
  "width": 660,
  "height": 555,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -134,
      0,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "js/ausStates.topojson",
        "format": {
          "type": "topojson",
          "feature": "ausStates"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef1f4",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "lookup": "code",
          "from": {
            "data": {
              "url": "data/ausplay_state_participation.csv"
            },
            "key": "code",
            "fields": [
              "participants",
              "active_3plus",
              "active_1plus",
              "state"
            ]
          }
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "opacity": 0.9,
        "stroke": "#0b3d4a",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "participants",
          "type": "quantitative",
          "title": "Adults active (count)",
          "scale": {
            "range": [
              60,
              1600
            ]
          },
          "legend": {
            "orient": "left",
            "offset": 14,
            "direction": "vertical",
            "format": ".2s",
            "symbolFillColor": "#b8bcc4",
            "symbolStrokeColor": "#5a6270",
            "symbolStrokeWidth": 1,
            "symbolType": "circle"
          }
        },
        "color": {
          "field": "active_3plus",
          "type": "quantitative",
          "title": "% active 3+/week",
          "scale": {
            "scheme": "greens",
            "domain": [
              46,
              60
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 150,
            "titleAnchor": "start",
            "offset": 10
          }
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "participants",
            "type": "quantitative",
            "title": "Adults active",
            "format": ","
          },
          {
            "field": "active_1plus",
            "type": "quantitative",
            "title": "Active 1+/yr %"
          },
          {
            "field": "active_3plus",
            "type": "quantitative",
            "title": "Active 3+/week %"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_labels.csv"
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "dy": -20
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "code",
          "type": "nominal"
        }
      }
    }
  ]
}